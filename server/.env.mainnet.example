# Mezo mainnet — service instance (copy to .env.mainnet and fill the key)
#
# The judge-facing terminal runs against testnet. A mainnet instance is a second
# configuration of the same binary — nothing about the service is testnet-specific.
#
#   cp .env.mainnet.example .env.mainnet
#   # set PRIVATE_KEY to a key you are happy to sign mainnet transactions with
#   set -a && . ./.env.mainnet && set +a
#   ./target/release/pylon-server serve
#
# The private key is deliberately absent: keep it out of the repository, and prefer a
# key that is not the one used anywhere else (see the ownership notes in the runbook).

CHAIN_ID=31612
RPC_URL=https://jsonrpc-mezo.boar.network
DEPLOYMENT=../contracts/deployments/31612.json
DATA_DIR=./data-mainnet
PORT=8788

# The address that receives x402 payments on mainnet. It must be a different address from
# the payer, because MUSD refuses self-transfers.
X402_PAY_TO=0x4B965638eE7e42587019774fF50407204F83990d

# Keep the keeper off until it has its own key; a position list is only useful with one.
AUTO_DEFEND=0
POSITIONS=
