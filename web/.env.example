# Pylon engine API base URL (Rust service).
# When unreachable the terminal degrades to direct Mezo Testnet RPC reads (marked READ-ONLY / RPC).
NEXT_PUBLIC_API_BASE=http://localhost:8787

# Optional RPC override. Defaults to the public Mezo Testnet endpoint.
NEXT_PUBLIC_MEZO_RPC=https://rpc.test.mezo.org
