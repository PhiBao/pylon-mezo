{
  "voice": "en-US-GuyNeural",
  "segments": [
    {
      "id": "s1_hook",
      "text": "Mezo gives anyone a Bitcoin-backed loan. Pylon makes that loan something you can steer: leverage it, deleverage it, or defend it. One transaction each.",
      "scene": {
        "kind": "card",
        "template": "title-left",
        "vars": {
          "kicker": "MEZO BUILDATHON &middot; TRACK 1 &mdash; DEFI"
        }
      }
    },
    {
      "id": "s2_queue",
      "text": "Every Mezo trove sits in one redemption queue: four hundred and twenty-nine million MUSD deep, across two hundred and ninety-six troves. Redemptions start at the lowest ratio above one hundred and ten percent, with no liquidation warning. Repaying needs MUSD a borrower may not have.",
      "scene": {
        "kind": "page",
        "src": "https://pylon-mezo.vercel.app/",
        "zoom": 1.2,
        "wait_for": [
          "text=Redemption radar"
